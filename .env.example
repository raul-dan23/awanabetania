# Configuration for running the backend locally.
#
#   cp .env.example .env      # .env is git-ignored; never commit real values
#
# Spring Boot reads .env from the directory it starts in (spring.config.import in
# application.properties). In production the same names are environment variables or
# entries in /var/www/html/application.properties.
#
# Format: KEY=value, one per line, no quotes and no spaces around "=".

# --- Database (MySQL 8) ---------------------------------------------------------------
# Optional; this is the default.
DB_URL=jdbc:mysql://localhost:3306/awana_club_manager
DB_USERNAME=awana
DB_PASSWORD=change-me

# --- Authentication -------------------------------------------------------------------
# Signs the login tokens. At least 32 characters; anyone who knows it can forge a login.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Legacy key, needed only until every account has logged in once (old AES passwords are
# converted to BCrypt at login). Exactly 16 characters.
AES_SECRET_KEY=change-me-16chr!

# "Continue with Google" for leaders: the OAuth Client ID from Google Cloud Console
# (public, not a secret). Leave empty to hide the Google button.
# Setup steps: docs/OPERATIONS.md, section "Autentificare cu Google".
GOOGLE_CLIENT_ID=

# --- Admin and devices ----------------------------------------------------------------
# PIN for the Control Center, product management and Olympiad sessions.
ADMIN_PIN=change-me

# Shared secret the local NFC bridge sends in the X-NFC-Token header.
NFC_TOKEN=change-me

# --- Browser access -------------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated). Not needed for
# `npm run dev`: the Vite dev server proxies /api, so the browser sees one origin.
CORS_ALLOWED_ORIGINS=https://awana.betania-tm.ro
