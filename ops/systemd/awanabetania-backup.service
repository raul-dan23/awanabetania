# Backup zilnic al bazei de date, pornit de awanabetania-backup.timer.
# Instalare: vezi docs/OPERATIONS.md, sectiunea "Backup".
[Unit]
Description=AwanaBetania - backup al bazei de date
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
# Acelasi utilizator ca aplicatia: citeste application.properties si scrie in ~/awanabetania-backups.
User=awana
WorkingDirectory=/var/www/html
ExecStart=/var/www/html/scripts/backup-db.sh daily
# Copia pe Google Drive si cate backup-uri raman pe server se seteaza in
# /var/www/html/application.properties (backup.rclone-remote, backup.keep-local), ca pentru
# orice backup: vezi docs/OPERATIONS.md, sectiunea "Backup si restaurare".
